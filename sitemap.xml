---
layout: null
sitemap: false
---
{%- comment -%}
  Replaces jekyll-sitemap's file so that every address has a <lastmod>. Pages without their own date get the build time here;
  when the site is deployed, scripts/sitemap_lastmod.py swaps that for the date of the last commit that changed the page
  (its file, the page template it includes and that template's data). The <!--src:...--> notes are for that script and are removed by it.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign collections = site.collections | where_exp: 'c', 'c.output != false' %}
{%- for collection in collections %}
{%- assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
{%- for doc in docs %}
<url>
<loc>{{ doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
<lastmod>{{ doc.last_modified_at | default: doc.date | default: site.time | date_to_xmlschema }}</lastmod>{% unless doc.last_modified_at or doc.date %}<!--src:{{ doc.path }}-->{% endunless %}
</url>
{%- endfor %}
{%- endfor %}
{%- assign pages = site.html_pages | where_exp: 'p', 'p.sitemap != false' | where_exp: 'p', 'p.url != "/404.html"' %}
{%- for p in pages %}
<url>
<loc>{{ p.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
<lastmod>{{ p.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>{% unless p.last_modified_at %}<!--src:{{ p.path }}-->{% endunless %}
</url>
{%- endfor %}
{%- for f in site.static_files %}{% if f.extname == '.pdf' and f.path contains '/assets/cv/' %}
<url>
<loc>{{ f.path | absolute_url | xml_escape }}</loc>
<lastmod>{{ f.modified_time | date_to_xmlschema }}</lastmod><!--src:{{ f.relative_path | remove_first: '/' }}-->
</url>
{%- endif %}{% endfor %}
</urlset>
